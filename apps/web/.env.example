# =====================================================================
# Aunty.pk - Web (Next.js) Environment
# Copy this file to `.env.local` and adjust values:
#   cp apps/web/.env.example apps/web/.env.local
# =====================================================================

# API base URL - NestJS backend
NEXT_PUBLIC_API_URL=http://localhost:3030/api

# CDN base URL — self-hosted image CDN (apps/cdn). Production me Nginx /cdn proxies 127.0.0.1:3031
NEXT_PUBLIC_CDN_URL=http://localhost:3031

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NODE_ENV=development
